{
  "name": "@team/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/run-next.mjs dev",
    "start": "node --env-file-if-exists=.env.local scripts/run-next.mjs start",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@team/contract": "0.0.0",
    "fastify": "5.12.8",
    "fastify-plugin": "5.1.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "jsdom": "31.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@testing-library/jest-dom": "7.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0"
  }
}
