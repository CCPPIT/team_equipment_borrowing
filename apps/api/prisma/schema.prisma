generator client { // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  provider = "prisma-client-js" // تحديد مزود قاعدة البيانات أو مولد العميل
} // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
datasource db { // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  provider = "postgresql" // تحديد مزود قاعدة البيانات أو مولد العميل
} // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
model Employee { // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  id String @id @db.Uuid // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  name String // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  createdAt DateTime @default(now()) @db.Timestamptz(3) // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  loans Loan[] // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
} // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
model Equipment { // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  id String @id @db.Uuid // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  name String // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  description String? // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  totalQuantity Int // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  availableQuantity Int // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  createdAt DateTime @default(now()) @db.Timestamptz(3) // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  loans Loan[] // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
} // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
model Loan { // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  id String @id @db.Uuid // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  employeeId String @db.Uuid // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  equipmentId String @db.Uuid // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  borrowedAt DateTime @default(now()) @db.Timestamptz(3) // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  returnedAt DateTime? @db.Timestamptz(3) // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict) // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict) // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
  @@index([equipmentId], map: "idx_loan_equipment") // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
} // تعريف النموذج أو الحقل أو العلاقة وفق التصميم المعتمد
