# مثال محلي؛ استبدل بيانات الاتصال ولا تحفظ أسرارًا فعلية
NODE_ENV=development # قيمة إعداد محلية موضحة في دليل التشغيل
# منفذ الخادم المعتمد
API_PORT=3001 # قيمة إعداد محلية موضحة في دليل التشغيل
# اتصال التطوير فقط؛ إعداد trust محلي معزول فقط؛ استخدم كلمة مرور عند استخدام خادم مختلف
DATABASE_URL=postgresql://team_equipment@127.0.0.1:5432/team_equipment?schema=public # قيمة إعداد محلية موضحة في دليل التشغيل
# قاعدة معزولة يجب أن ينتهي اسمها بلاحقة الاختبار
TEST_DATABASE_URL=postgresql://team_equipment@127.0.0.1:5432/team_equipment_test?schema=public # قيمة إعداد محلية موضحة في دليل التشغيل
# مرجع إعداد الواجهة؛ انسخ القيمتين فقط إلى apps/web/.env.local ولا تنسخ اتصال قاعدة البيانات
WEB_PORT=3000 # قيمة إعداد محلية موضحة في دليل التشغيل
API_BASE_URL=http://127.0.0.1:3001 # قيمة إعداد محلية موضحة في دليل التشغيل

# اختبار Phase05 فقط؛ قاعدة منفصلة عن التطوير واختبارات المراحل السابقة، ولا تنسخها إلى web
SYSTEM_DATABASE_URL=postgresql://team_equipment@127.0.0.1:5432/team_equipment_phase05_test?schema=public # اتصال محلي معزول بلا كلمة مرور؛ استبدله وفق بيئتك
